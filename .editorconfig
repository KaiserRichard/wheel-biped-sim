root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,c,h}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.{kicad_pcb,kicad_sch,kicad_pro,kicad_sym,csv,dbc}]
trim_trailing_whitespace = false
insert_final_newline = false
